From b1e7aa50805f8cb914bfd47cddebaa4f53a31460 Mon Sep 17 00:00:00 2001
From: hmos2sweet <hmos2sweet@localhost>
Date: Sat, 24 Oct 2026 09:17:32 +0200
Subject: [PATCH 16/18] input: aw8624: expose the motor as
 /sys/class/leds/vibrator

The HarmonyOS vibrator HDI drives timed vibrations through the
Android-style LED class device (state, duration, activate). Mirror the
driver's own duration/activate attributes there.
---
 drivers/misc/aw8624_haptic/aw8624.c | 81 +++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)

diff --git a/drivers/misc/aw8624_haptic/aw8624.c b/drivers/misc/aw8624_haptic/aw8624.c
index f7bde8a84..5af5afff3 100755
--- a/drivers/misc/aw8624_haptic/aw8624.c
+++ b/drivers/misc/aw8624_haptic/aw8624.c
@@ -15,6 +15,7 @@
  */
 
 #include <linux/module.h>
+#include <linux/leds.h>
 #include <linux/kernel.h>
 #include <linux/i2c.h>
 #include <linux/of_gpio.h>
@@ -3954,6 +3955,85 @@ static struct attribute_group aw8624_vibrator_attribute_group = {
  * i2c driver
  *
  ******************************************************/
+/*
+ * HarmonyOS (Huawei vibrator HDI) drives timed vibrations through the
+ * Android-style LED class device /sys/class/leds/vibrator with "state",
+ * "duration" and "activate". Mirror the driver's own attributes there.
+ */
+static int aw8624_led_state;
+
+static void aw8624_led_brightness_set(struct led_classdev *cdev, enum led_brightness b)
+{
+}
+
+static ssize_t aw8624_led_duration_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return g_aw8624 ? aw8624_duration_show(g_aw8624->dev, attr, buf) : -ENODEV;
+}
+
+static ssize_t aw8624_led_duration_store(struct device *dev, struct device_attribute *attr,
+					 const char *buf, size_t count)
+{
+	return g_aw8624 ? aw8624_duration_store(g_aw8624->dev, attr, buf, count) : -ENODEV;
+}
+
+static ssize_t aw8624_led_activate_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return g_aw8624 ? aw8624_activate_show(g_aw8624->dev, attr, buf) : -ENODEV;
+}
+
+static ssize_t aw8624_led_activate_store(struct device *dev, struct device_attribute *attr,
+					 const char *buf, size_t count)
+{
+	return g_aw8624 ? aw8624_activate_store(g_aw8624->dev, attr, buf, count) : -ENODEV;
+}
+
+static ssize_t aw8624_led_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return snprintf(buf, PAGE_SIZE, "%d\n", aw8624_led_state);
+}
+
+static ssize_t aw8624_led_state_store(struct device *dev, struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	int v = 0;
+
+	if (kstrtoint(buf, 0, &v) == 0)
+		aw8624_led_state = v;
+	return count;
+}
+
+static ssize_t aw8624_led_min_timeout_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return snprintf(buf, PAGE_SIZE, "%d\n", 10);
+}
+
+static struct device_attribute aw8624_led_attrs[] = {
+	__ATTR(duration, 0664, aw8624_led_duration_show, aw8624_led_duration_store),
+	__ATTR(activate, 0664, aw8624_led_activate_show, aw8624_led_activate_store),
+	__ATTR(state, 0664, aw8624_led_state_show, aw8624_led_state_store),
+	__ATTR(vibrator_min_timeout, 0444, aw8624_led_min_timeout_show, NULL),
+};
+
+static struct led_classdev aw8624_led_cdev = {
+	.name = "vibrator",
+	.brightness_set = aw8624_led_brightness_set,
+	.max_brightness = 1,
+};
+
+static void aw8624_register_led_vibrator(struct aw8624 *aw8624)
+{
+	int i, rc = led_classdev_register(aw8624->dev, &aw8624_led_cdev);
+
+	if (rc) {
+		dev_err(aw8624->dev, "vibrator led class device: %d\n", rc);
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(aw8624_led_attrs); i++)
+		if (device_create_file(aw8624_led_cdev.dev, &aw8624_led_attrs[i]))
+			dev_err(aw8624->dev, "vibrator led attr %s failed\n", aw8624_led_attrs[i].attr.name);
+}
+
 static int
 aw8624_i2c_probe(struct i2c_client *i2c, const struct i2c_device_id *id)
 {
@@ -4145,6 +4225,7 @@ aw8624_i2c_probe(struct i2c_client *i2c, const struct i2c_device_id *id)
 	}
 
 	g_aw8624 = aw8624;
+	aw8624_register_led_vibrator(aw8624);
 
 	pr_info("%s probe completed successfully!\n", __func__);
 
-- 
